---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  allLabs: Array<{
    id: string;
    data: {
      title: string;
      category: string;
      order?: number;
    };
  }>;
  currentId: string;
}

const { title, description = '개발자 & 강사 포트폴리오 및 실습 자료', allLabs, currentId } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseURL = import.meta.env.BASE_URL;

const categoryNames = [...new Set(allLabs.map(lab => lab.data.category))].sort();
const categories = categoryNames.map(cat => ({
  name: cat,
  labs: allLabs
    .filter(lab => lab.data.category === cat)
    .sort((a, b) => {
      if (a.data.order !== undefined && b.data.order !== undefined) {
        return a.data.order - b.data.order;
      }
      if (a.data.order !== undefined) return -1;
      if (b.data.order !== undefined) return 1;
      return a.data.title.localeCompare(b.data.title, 'ko');
    }),
}));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="preload"
      href="https://cdn.jsdelivr.net/npm/pretendard@latest/dist/web/variable/pretendardvariable-dynamic-subset.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white text-neutral-900 font-sans antialiased">

    <!-- Frosted glass nav -->
    <nav class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-neutral-200/60">
      <div class="mx-auto max-w-screen-xl px-6 flex items-center justify-between h-14">
        <a href={baseURL} class="text-base font-semibold tracking-tight transition-opacity hover:opacity-60">
          sepn0r
        </a>
        <button
          id="menu-toggle"
          class="sm:hidden p-2 -mr-2 rounded-lg transition-colors hover:bg-neutral-100"
          aria-label="메뉴 열기"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
          </svg>
        </button>
        <ul class="hidden sm:flex items-center gap-8 text-sm text-neutral-500">
          <li><a href={`${baseURL}/labs/`} class="transition-colors hover:text-neutral-900">Labs</a></li>
          <li><a href={`${baseURL}/portfolio/`} class="transition-colors hover:text-neutral-900">Portfolio</a></li>
          <li><a href={`${baseURL}/about/`} class="transition-colors hover:text-neutral-900">About</a></li>
        </ul>
      </div>
    </nav>

    <!-- Mobile menu overlay -->
    <div
      id="mobile-menu"
      class="fixed inset-0 z-50 bg-white/95 backdrop-blur-xl hidden flex-col items-center justify-center gap-6"
    >
      <button
        id="menu-close"
        class="absolute top-4 right-5 p-2 rounded-lg transition-colors hover:bg-neutral-100"
        aria-label="메뉴 닫기"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <a href={baseURL} class="text-xl font-medium text-neutral-900 transition-opacity hover:opacity-60">Home</a>
      <a href={`${baseURL}/labs/`} class="text-xl font-medium text-neutral-900 transition-opacity hover:opacity-60">Labs</a>
      <a href={`${baseURL}/portfolio/`} class="text-xl font-medium text-neutral-900 transition-opacity hover:opacity-60">Portfolio</a>
      <a href={`${baseURL}/about/`} class="text-xl font-medium text-neutral-900 transition-opacity hover:opacity-60">About</a>
    </div>

    <!-- Sidebar + Content layout -->
    <div class="flex">

      <!-- Desktop sidebar -->
      <aside class="hidden lg:flex flex-col w-64 shrink-0 border-r border-neutral-200/60 sticky top-14 h-[calc(100vh-3.5rem)] overflow-y-auto px-5 py-8">
        <div class="mb-6">
          <a
            href={`${baseURL}/labs/`}
            class="text-xs font-medium text-neutral-400 transition-colors hover:text-neutral-600"
          >
            &larr; 모든 실습 자료
          </a>
        </div>

        {categories.map(cat => (
          <div class="mb-6">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2 px-3">
              {cat.name}
            </h3>
            {cat.labs.map(lab => (
              <a
                href={`${baseURL}/labs/${lab.id}/`}
                class={`block rounded-lg px-3 py-1.5 text-sm transition-all duration-150 ${
                  lab.id === currentId
                    ? 'bg-neutral-100 text-neutral-900 font-medium'
                    : 'text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50'
                }`}
              >
                {lab.data.title}
              </a>
            ))}
          </div>
        ))}

        <div class="mb-6">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2 px-3">
            도구
          </h3>
          <a
            href={`${baseURL}/labs/prompt-scorer/`}
            class={`block rounded-lg px-3 py-1.5 text-sm transition-all duration-150 ${
              currentId === 'prompt-scorer'
                ? 'bg-neutral-100 text-neutral-900 font-medium'
                : 'text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50'
            }`}
          >
            프롬프트 점수 측정기
          </a>
        </div>
      </aside>

      <!-- Mobile sidebar overlay -->
      <div
        id="sidebar-overlay"
        class="fixed inset-0 z-40 bg-white/95 backdrop-blur-xl overflow-y-auto hidden lg:hidden"
      >
        <div class="flex items-center justify-between px-6 py-4 border-b border-neutral-200/60">
          <span class="text-sm font-semibold text-neutral-700">목차</span>
          <button
            id="sidebar-close"
            class="p-2 -mr-2 rounded-lg transition-colors hover:bg-neutral-100"
            aria-label="목차 닫기"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="px-5 py-6">
          <div class="mb-6">
            <a
              href={`${baseURL}/labs/`}
              class="text-xs font-medium text-neutral-400 transition-colors hover:text-neutral-600"
            >
              &larr; 모든 실습 자료
            </a>
          </div>

          {categories.map(cat => (
            <div class="mb-6">
              <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2 px-3">
                {cat.name}
              </h3>
              {cat.labs.map(lab => (
                <a
                  href={`${baseURL}/labs/${lab.id}/`}
                  class={`block rounded-lg px-3 py-1.5 text-sm transition-all duration-150 ${
                    lab.id === currentId
                      ? 'bg-neutral-100 text-neutral-900 font-medium'
                      : 'text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50'
                  }`}
                >
                  {lab.data.title}
                </a>
              ))}
            </div>
          ))}

          <div class="mb-6">
            <h3 class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-2 px-3">
              도구
            </h3>
            <a
              href={`${baseURL}/labs/prompt-scorer/`}
              class={`block rounded-lg px-3 py-1.5 text-sm transition-all duration-150 ${
                currentId === 'prompt-scorer'
                  ? 'bg-neutral-100 text-neutral-900 font-medium'
                  : 'text-neutral-500 hover:text-neutral-900 hover:bg-neutral-50'
              }`}
            >
              프롬프트 점수 측정기
            </a>
          </div>
        </div>
      </div>

      <!-- Main content -->
      <main class="flex-1 min-w-0 px-6 py-10 sm:py-14">
        <!-- Mobile TOC button -->
        <div class="lg:hidden mb-8">
          <button
            id="sidebar-toggle"
            class="inline-flex items-center gap-2 text-sm text-neutral-500 hover:text-neutral-900 rounded-full border border-neutral-200 px-4 py-2 transition-all duration-200 hover:border-neutral-300 hover:shadow-sm"
            aria-expanded="false"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h10.5M3.75 17.25h16.5" />
            </svg>
            목차 보기
          </button>
        </div>

        <div class="max-w-3xl mx-auto fade-in">
          <slot />
        </div>
      </main>
    </div>

    <script is:inline>
      const toggle = document.getElementById('menu-toggle');
      const close = document.getElementById('menu-close');
      const menu = document.getElementById('mobile-menu');

      function openMenu() {
        menu?.classList.remove('hidden');
        menu?.classList.add('flex');
        toggle?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        menu?.classList.add('hidden');
        menu?.classList.remove('flex');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        toggle?.focus();
      }

      toggle?.addEventListener('click', openMenu);
      close?.addEventListener('click', closeMenu);

      const sidebarToggle = document.getElementById('sidebar-toggle');
      const sidebarClose = document.getElementById('sidebar-close');
      const sidebarOverlay = document.getElementById('sidebar-overlay');

      function openSidebar() {
        sidebarOverlay?.classList.remove('hidden');
        sidebarToggle?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeSidebar() {
        sidebarOverlay?.classList.add('hidden');
        sidebarToggle?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        sidebarToggle?.focus();
      }

      sidebarToggle?.addEventListener('click', openSidebar);
      sidebarClose?.addEventListener('click', closeSidebar);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (!menu?.classList.contains('hidden')) closeMenu();
          if (!sidebarOverlay?.classList.contains('hidden')) closeSidebar();
        }
      });
    </script>
  </body>
</html>
