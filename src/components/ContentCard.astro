---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
}

const { title, description, tags, href } = Astro.props;
---

<a href={href} class="group block">
  <article class="border border-neutral-200 rounded-lg p-5 transition-colors group-hover:border-neutral-400">
    <h3 class="font-semibold text-neutral-900 group-hover:text-neutral-600 transition-colors">
      {title}
    </h3>
    <p class="mt-2 text-sm text-neutral-500 line-clamp-2">{description}</p>
    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="inline-block rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600">
            {tag}
          </span>
        ))}
      </div>
    )}
  </article>
</a>
