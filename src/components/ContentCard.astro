---
interface Props {
  title: string;
  description: string;
  tags: string[];
  href: string;
}

const { title, description, tags, href } = Astro.props;
---

<a href={href} class="group block">
  <article class="rounded-2xl bg-neutral-50/50 p-6 transition-all duration-300 ease-out group-hover:bg-neutral-50 group-hover:shadow-lg group-hover:shadow-neutral-200/50 group-hover:-translate-y-0.5">
    <h3 class="text-base font-semibold text-neutral-900 tracking-tight">
      {title}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-neutral-500 line-clamp-2">{description}</p>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="inline-block rounded-full bg-neutral-200/60 px-2.5 py-0.5 text-xs font-medium text-neutral-500">
            {tag}
          </span>
        ))}
      </div>
    )}
  </article>
</a>
