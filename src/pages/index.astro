---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const baseURL = import.meta.env.BASE_URL;
const allLabs = await getCollection('labs');
const featuredLabs = allLabs
  .filter((lab) => lab.data.featured)
  .toSorted((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentLabs = [...allLabs]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
const labsToShow = featuredLabs.length > 0 ? featuredLabs : recentLabs;
---

<BaseLayout title="sepn0r — 개발자 & 강사">
  <!-- Hero -->
  <section class="pt-12 pb-20 sm:pt-20 sm:pb-28 fade-in">
    <p class="text-sm font-medium text-neutral-400 tracking-widest uppercase">Developer & Instructor</p>
    <h1 class="mt-4 text-5xl sm:text-6xl font-bold tracking-tight leading-[1.1]">
      안녕하세요,<br />
      <span class="text-neutral-400">sepn0r</span>입니다.
    </h1>
    <p class="mt-6 text-lg sm:text-xl text-neutral-500 max-w-2xl leading-relaxed">
      개발자이자 강사로서 실습 자료와 프로젝트를 공유합니다.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={`${baseURL}/labs/`}
        class="inline-flex items-center rounded-full bg-neutral-900 px-6 py-3 text-sm font-medium text-white transition-all duration-200 hover:bg-neutral-700 hover:shadow-lg hover:shadow-neutral-300/30"
      >
        실습 자료 보기
      </a>
      <a
        href={`${baseURL}/about/`}
        class="inline-flex items-center rounded-full border border-neutral-300 px-6 py-3 text-sm font-medium text-neutral-600 transition-all duration-200 hover:border-neutral-400 hover:text-neutral-900 hover:shadow-sm"
      >
        소개
      </a>
    </div>
  </section>

  <!-- Featured / Recent labs -->
  {labsToShow.length > 0 && (
    <section class="pb-20 sm:pb-28 fade-in fade-in-delay-2">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">
          {featuredLabs.length > 0 ? '추천 실습 자료' : '최근 실습 자료'}
        </h2>
        <a
          href={`${baseURL}/labs/`}
          class="text-sm text-neutral-400 transition-colors hover:text-neutral-900"
        >
          모두 보기 &rarr;
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {labsToShow.map((lab) => (
          <ContentCard
            title={lab.data.title}
            description={lab.data.description}
            tags={lab.data.tags}
            href={`${baseURL}/labs/${lab.id}/`}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
