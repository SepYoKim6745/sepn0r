---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';

const allLabs = await getCollection('labs');
const baseURL = import.meta.env.BASE_URL;
---

<DocsLayout
  title="프롬프트 점수 측정기 — sepn0r"
  description="R.C.I.F.C 기준으로 프롬프트를 평가하고 점수를 확인하세요."
  allLabs={allLabs}
  currentId=""
>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">프롬프트 점수 측정기</h1>
      <p class="mt-2 text-neutral-500">
        작성한 프롬프트를 입력하면 <strong>R.C.I.F.C</strong> 기준으로 평가하고 점수를 알려드립니다.
      </p>
    </header>

    <!-- 입력 영역 -->
    <div class="space-y-3">
      <label for="prompt-input" class="block text-sm font-medium text-neutral-700">
        프롬프트 입력
      </label>
      <textarea
        id="prompt-input"
        rows="7"
        placeholder="평가할 프롬프트를 입력하세요.&#10;예) 너는 여행 전문 플래너야. 친구 3명과 5월 오사카 3박 4일 여행 일정을 표로 짜줘. 동선 고려해줘."
        class="w-full rounded-lg border border-neutral-200 px-4 py-3 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-400 focus:outline-none resize-none leading-relaxed"
      ></textarea>
      <div class="flex items-center justify-between">
        <span id="char-count" class="text-xs text-neutral-400">0자</span>
        <button
          id="evaluate-btn"
          class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-neutral-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span id="btn-text">평가하기</span>
          <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- 결과 영역 -->
    <div id="result" class="hidden mt-10 space-y-6">

      <!-- 구분선 -->
      <div class="border-t border-neutral-200"></div>

      <!-- 총점 -->
      <div class="flex items-center gap-6">
        <div
          id="score-badge"
          class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-full border-4 border-neutral-900 text-neutral-900"
        >
          <span id="total-score" class="text-2xl font-bold leading-none">0</span>
          <span class="text-xs text-neutral-500">/ 100</span>
        </div>
        <div>
          <p id="score-label" class="text-lg font-semibold text-neutral-900"></p>
          <p id="score-desc" class="mt-0.5 text-sm text-neutral-500"></p>
        </div>
      </div>

      <!-- 항목별 점수 -->
      <div class="rounded-lg border border-neutral-200 divide-y divide-neutral-100 overflow-hidden">
        {[
          { key: 'role',       label: 'R — Role',        desc: '누구처럼 답할지 (역할 지정)' },
          { key: 'context',    label: 'C — Context',     desc: '어떤 상황인지 (맥락 제공)' },
          { key: 'instruction',label: 'I — Instruction', desc: '무엇을 해야 하는지 (지시)' },
          { key: 'format',     label: 'F — Format',      desc: '어떤 형식으로 출력할지' },
          { key: 'constraint', label: 'C — Constraint',  desc: '지켜야 할 조건 / 제약' },
        ].map(item => (
          <div class="px-4 py-3">
            <div class="flex items-center justify-between mb-1.5">
              <div>
                <span class="text-sm font-medium text-neutral-800">{item.label}</span>
                <span class="ml-2 text-xs text-neutral-400">{item.desc}</span>
              </div>
              <span id={`score-${item.key}`} class="text-sm font-semibold text-neutral-700 tabular-nums w-12 text-right">
                — / 20
              </span>
            </div>
            <div class="h-1.5 w-full rounded-full bg-neutral-100 overflow-hidden">
              <div
                id={`bar-${item.key}`}
                class="h-full rounded-full transition-all duration-500"
                style="width: 0%"
              ></div>
            </div>
            <p id={`feedback-${item.key}`} class="mt-1.5 text-xs text-neutral-500"></p>
          </div>
        ))}
      </div>

      <!-- 종합 피드백 -->
      <div id="summary-box" class="rounded-lg bg-neutral-50 border border-neutral-200 px-4 py-3">
        <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-1">종합 피드백</p>
        <p id="summary-text" class="text-sm text-neutral-700 leading-relaxed"></p>
      </div>

      <!-- 다시 평가 -->
      <button
        id="reset-btn"
        class="text-sm text-neutral-400 hover:text-neutral-700 transition-colors"
      >
        ↩ 다시 입력하기
      </button>
    </div>
  </article>
</DocsLayout>

<script is:inline>
// ─────────────────────────────────────────────
// 평가 엔진
// TODO: 아래 scoreWithKeywords() 함수를 LLM API 호출로 교체한다.
//       예: Gemini API / Claude API 등을 이용해 각 항목별 점수와 피드백을 받아온다.
//       반환 형식은 동일하게 유지하면 된다.
// ─────────────────────────────────────────────

function scoreWithKeywords(prompt) {
  const p = prompt;
  const pl = prompt.toLowerCase();

  // R — Role: 역할 지정 키워드
  const rolePatterns = [
    /너는|당신은|you are/i,
    /전문가|플래너|코치|강사|선생|컨설턴트|분석가|작가|디자이너|개발자|의사|변호사|상담사|매니저|크리에이터/,
    /~야|~입니다|로서|로서의|입장에서/,
  ];
  const roleScore = rolePatterns.filter(r => r.test(p)).length;

  // C — Context: 맥락 제공 (상황, 배경, 대상)
  const contextPatterns = [
    /\d+명|\d+박\s*\d+일|\d+일|\d+시간|\d+주|\d+달|\d+개월/,
    /나는|제가|우리|저는|친구|부모님|팀원|회사|학교|직장/,
    /현재|지금|요즘|최근|이번|다음|올해|작년/,
    /왜냐면|때문에|상황은|배경은|목적은/,
    p.length > 80 ? true : false,  // 길이 기반 휴리스틱
  ];
  const contextScore = contextPatterns.filter(r => typeof r === 'boolean' ? r : r.test(p)).length;

  // I — Instruction: 명확한 지시
  const instructionPatterns = [
    /써줘|써주세요|작성해|작성해줘/i,
    /만들어|만들어줘|만들어주세요/i,
    /알려줘|알려주세요|추천해|추천해줘/i,
    /분석해|분석해줘|설명해|설명해줘/i,
    /짜줘|정리해|요약해|비교해|평가해/i,
  ];
  const instructionScore = instructionPatterns.filter(r => r.test(p)).length;

  // F — Format: 출력 형식 지정
  const formatPatterns = [
    /표로|테이블로|목록으로|리스트로/,
    /번호|번호로|단계별|순서대로/,
    /\d+문단|\d+줄|\d+개|\d+자 이내|\d+자 내외/,
    /형식|형태|구조|포맷|틀|양식/,
    /오전.오후.저녁|아침.점심.저녁|날짜별|항목별|분류별/,
  ];
  const formatScore = formatPatterns.filter(r => r.test(p)).length;

  // C — Constraint: 제약 조건
  const constraintPatterns = [
    /이내|이하|이상|초과|미만/,
    /금지|빼고|제외|빼줘|넣지 마/,
    /반드시|꼭|무조건|절대/,
    /고려해|고려해줘|주의해|주의해줘/,
    /않게|않도록|안 되게|넘지 않/,
  ];
  const constraintScore = constraintPatterns.filter(r => r.test(p)).length;

  // 점수 환산 (각 항목 최대 20점)
  const toScore = (matched, max) => Math.min(20, Math.round((matched / max) * 20));

  const scores = {
    role:        toScore(roleScore, 2),
    context:     toScore(contextScore, 3),
    instruction: toScore(instructionScore, 2),
    format:      toScore(formatScore, 2),
    constraint:  toScore(constraintScore, 2),
  };

  // 피드백
  const feedback = {
    role: scores.role >= 16
      ? '역할이 명확하게 지정되어 있습니다.'
      : scores.role >= 8
      ? '역할이 일부 언급되어 있지만 더 구체적으로 지정해보세요.'
      : '역할을 지정하지 않았습니다. "너는 ~야" 형태로 AI의 역할을 설정하면 더 좋은 답변을 얻을 수 있어요.',

    context: scores.context >= 16
      ? '충분한 맥락과 배경 정보가 포함되어 있습니다.'
      : scores.context >= 8
      ? '맥락이 일부 있지만, 상황을 더 구체적으로 설명하면 좋겠습니다.'
      : '맥락이 부족합니다. 누가, 어떤 상황에서, 왜 필요한지 추가해보세요.',

    instruction: scores.instruction >= 16
      ? '원하는 작업이 명확하게 전달되었습니다.'
      : scores.instruction >= 8
      ? '지시가 있지만 더 구체적으로 무엇을 해야 하는지 명시해보세요.'
      : '지시(Instruction)가 불명확합니다. "~해줘", "~작성해줘" 등으로 명확히 요청하세요.',

    format: scores.format >= 16
      ? '출력 형식이 잘 지정되어 있습니다.'
      : scores.format >= 8
      ? '형식이 일부 언급되어 있습니다. 더 구체적으로 지정하면 좋겠습니다.'
      : '출력 형식이 없습니다. "표로", "번호로", "~자 이내" 등 원하는 형식을 지정해보세요.',

    constraint: scores.constraint >= 16
      ? '제약 조건이 잘 설정되어 있습니다.'
      : scores.constraint >= 8
      ? '제약이 일부 있습니다. 더 추가하면 답변 품질이 올라갑니다.'
      : '제약 조건이 없습니다. "~이내", "~빼고", "~고려해줘" 등 지켜야 할 조건을 추가해보세요.',
  };

  return { scores, feedback };
}

// ─────────────────────────────────────────────
// UI 제어
// ─────────────────────────────────────────────

const input   = document.getElementById('prompt-input');
const charCount = document.getElementById('char-count');
const btn     = document.getElementById('evaluate-btn');
const btnText = document.getElementById('btn-text');
const spinner = document.getElementById('btn-spinner');
const result  = document.getElementById('result');
const resetBtn = document.getElementById('reset-btn');

// 글자 수 카운트
input.addEventListener('input', () => {
  charCount.textContent = `${input.value.length}자`;
});

// 바 색상: 점수에 따라
function barColor(score) {
  if (score >= 16) return 'bg-neutral-800';
  if (score >= 8)  return 'bg-neutral-400';
  return 'bg-neutral-200';
}

// 총점 라벨
function scoreLabel(total) {
  if (total >= 90) return { label: '완성도 높은 프롬프트', desc: '5가지 요소를 모두 잘 활용했습니다.' };
  if (total >= 70) return { label: '좋은 프롬프트', desc: '대부분의 요소가 포함되어 있습니다.' };
  if (total >= 50) return { label: '보통 프롬프트', desc: '일부 요소를 더 보강하면 좋겠습니다.' };
  if (total >= 30) return { label: '개선이 필요합니다', desc: 'R.C.I.F.C 요소를 추가로 활용해보세요.' };
  return { label: '기초 프롬프트', desc: '역할, 맥락, 형식 등을 추가해보세요.' };
}

// 종합 피드백 문장
function buildSummary(scores, total) {
  const missing = [];
  if (scores.role        < 10) missing.push('역할(R)');
  if (scores.context     < 10) missing.push('맥락(C)');
  if (scores.instruction < 10) missing.push('지시(I)');
  if (scores.format      < 10) missing.push('형식(F)');
  if (scores.constraint  < 10) missing.push('제약(C)');

  if (missing.length === 0) return '훌륭합니다! R.C.I.F.C 5가지 요소를 모두 활용한 완성도 높은 프롬프트입니다.';
  return `${missing.join(', ')} 요소가 부족합니다. 해당 항목을 보강하면 AI로부터 더 정확하고 유용한 답변을 얻을 수 있어요.`;
}

// 평가 실행
async function evaluate() {
  const prompt = input.value.trim();
  if (!prompt) {
    input.focus();
    return;
  }

  // 로딩 상태
  btn.disabled = true;
  btnText.textContent = '평가 중...';
  spinner.classList.remove('hidden');

  // ── TODO: LLM API 호출로 교체할 지점 ──────────────────────────
  // const response = await fetch('https://api.example.com/score', {
  //   method: 'POST',
  //   headers: { 'Content-Type': 'application/json' },
  //   body: JSON.stringify({ prompt }),
  // });
  // const { scores, feedback } = await response.json();
  // ──────────────────────────────────────────────────────────────

  // 현재는 키워드 기반 목업 스코어링
  await new Promise(r => setTimeout(r, 600)); // UX용 딜레이
  const { scores, feedback } = scoreWithKeywords(prompt);

  // 로딩 해제
  btn.disabled = false;
  btnText.textContent = '평가하기';
  spinner.classList.add('hidden');

  // 결과 표시
  const total = Object.values(scores).reduce((a, b) => a + b, 0);
  document.getElementById('total-score').textContent = total;

  const { label, desc } = scoreLabel(total);
  document.getElementById('score-label').textContent = label;
  document.getElementById('score-desc').textContent  = desc;

  const criteria = ['role', 'context', 'instruction', 'format', 'constraint'];
  criteria.forEach(key => {
    const s = scores[key];
    document.getElementById(`score-${key}`).textContent = `${s} / 20`;
    const bar = document.getElementById(`bar-${key}`);
    bar.style.width = `${(s / 20) * 100}%`;
    bar.className = `h-full rounded-full transition-all duration-500 ${barColor(s)}`;
    document.getElementById(`feedback-${key}`).textContent = feedback[key];
  });

  document.getElementById('summary-text').textContent = buildSummary(scores, total);

  result.classList.remove('hidden');
  result.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

btn.addEventListener('click', evaluate);

// 리셋
resetBtn.addEventListener('click', () => {
  input.value = '';
  charCount.textContent = '0자';
  result.classList.add('hidden');
  input.focus();
});

// Enter(Ctrl+Enter)로 평가
input.addEventListener('keydown', (e) => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') evaluate();
});
</script>
