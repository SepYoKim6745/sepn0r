---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';

const allLabs = await getCollection('labs');
const geminiKey = import.meta.env.PUBLIC_GEMINI_API_KEY ?? '';
---

<DocsLayout
  title="프롬프트 점수 측정기 — sepn0r"
  description="R.C.I.F.C 기준으로 프롬프트를 평가하고 점수를 확인하세요."
  allLabs={allLabs}
  currentId="prompt-scorer"
>
  <!-- API 키를 data 속성으로 전달 -->
  <div id="app-config" data-gemini-key={geminiKey} hidden></div>

  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">프롬프트 점수 측정기</h1>
      <p class="mt-2 text-neutral-500">
        작성한 프롬프트를 입력하면 <strong>R.C.I.F.C</strong> 기준으로 AI가 평가하고 점수를 알려드립니다.
      </p>
    </header>

    <!-- 입력 영역 -->
    <div class="space-y-3">
      <label for="prompt-input" class="block text-sm font-medium text-neutral-700">
        프롬프트 입력
      </label>
      <textarea
        id="prompt-input"
        rows="7"
        placeholder="평가할 프롬프트를 입력하세요.&#10;예) 너는 여행 전문 플래너야. 친구 3명과 5월 오사카 3박 4일 여행 일정을 표로 짜줘. 동선 고려해줘."
        class="w-full rounded-lg border border-neutral-200 px-4 py-3 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-400 focus:outline-none resize-none leading-relaxed"
      ></textarea>
      <div class="flex items-center justify-between">
        <span id="char-count" class="text-xs text-neutral-400">0자</span>
        <button
          id="evaluate-btn"
          class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-neutral-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
        >
          <span id="btn-text">평가하기</span>
          <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- 에러 메시지 -->
    <div id="error-box" class="hidden mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600"></div>

    <!-- 결과 영역 -->
    <div id="result" class="hidden mt-10 space-y-6">
      <div class="border-t border-neutral-200"></div>

      <!-- 총점 -->
      <div class="flex items-center gap-6">
        <div
          id="score-badge"
          class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-full border-4 border-neutral-900 text-neutral-900"
        >
          <span id="total-score" class="text-2xl font-bold leading-none">0</span>
          <span class="text-xs text-neutral-500">/ 100</span>
        </div>
        <div>
          <p id="score-label" class="text-lg font-semibold text-neutral-900"></p>
          <p id="score-desc" class="mt-0.5 text-sm text-neutral-500"></p>
        </div>
      </div>

      <!-- 항목별 점수 -->
      <div class="rounded-lg border border-neutral-200 divide-y divide-neutral-100 overflow-hidden">
        {[
          { key: 'role',        label: 'R — Role',        desc: '누구처럼 답할지 (역할 지정)' },
          { key: 'context',     label: 'C — Context',     desc: '어떤 상황인지 (맥락 제공)' },
          { key: 'instruction', label: 'I — Instruction', desc: '무엇을 해야 하는지 (지시)' },
          { key: 'format',      label: 'F — Format',      desc: '어떤 형식으로 출력할지' },
          { key: 'constraint',  label: 'C — Constraint',  desc: '지켜야 할 조건 / 제약' },
        ].map(item => (
          <div class="px-4 py-3">
            <div class="flex items-center justify-between mb-1.5">
              <div>
                <span class="text-sm font-medium text-neutral-800">{item.label}</span>
                <span class="ml-2 text-xs text-neutral-400">{item.desc}</span>
              </div>
              <span id={`score-${item.key}`} class="text-sm font-semibold text-neutral-700 tabular-nums w-12 text-right">
                — / 20
              </span>
            </div>
            <div class="h-1.5 w-full rounded-full bg-neutral-100 overflow-hidden">
              <div
                id={`bar-${item.key}`}
                class="h-full rounded-full transition-all duration-500"
                style="width: 0%"
              ></div>
            </div>
            <p id={`feedback-${item.key}`} class="mt-1.5 text-xs text-neutral-500"></p>
          </div>
        ))}
      </div>

      <!-- 종합 피드백 -->
      <div class="rounded-lg bg-neutral-50 border border-neutral-200 px-4 py-3">
        <p class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-1">종합 피드백</p>
        <p id="summary-text" class="text-sm text-neutral-700 leading-relaxed"></p>
      </div>

      <button id="reset-btn" class="text-sm text-neutral-400 hover:text-neutral-700 transition-colors">
        ↩ 다시 입력하기
      </button>
    </div>
  </article>
</DocsLayout>

<script is:inline>
// ── Gemini API 평가 ──────────────────────────────────────
const SYSTEM_INSTRUCTION = `당신은 프롬프트 엔지니어링 교육 전문가입니다.
수강생이 작성한 프롬프트를 R.C.I.F.C 프레임워크로 평가합니다.

## 평가 항목 및 채점 기준 (각 0~20점)

### R — Role (역할 지정)
AI에게 명확한 페르소나나 전문가 역할을 부여했는가.
- 20점: 구체적인 역할 + 전문성 수준까지 지정 (예: "10년 경력의 여행 플래너야")
- 14점: 역할은 명시했으나 수준이나 맥락 없음 (예: "너는 여행 플래너야")
- 8점: 역할이 암시되어 있으나 명시적이지 않음
- 0점: 역할 지정 없음

### C — Context (맥락 제공)
배경 정보, 상황, 사용자 조건이 충분히 설명되었는가.
- 20점: 목적 + 대상 + 상황 + 제약이 모두 기술됨
- 14점: 2~3가지 맥락 요소 포함
- 8점: 최소한의 맥락만 있음
- 0점: 맥락 없이 요청만 있음

### I — Instruction (명확한 지시)
해야 할 작업이 구체적이고 명확하게 기술되었는가.
- 20점: 작업이 단계별로 구체적이고 측정 가능하게 기술됨
- 14점: 명확한 동사 + 목적어로 요청이 명시됨
- 8점: 무엇을 원하는지 파악 가능하나 모호함
- 0점: 지시가 불분명하거나 없음

### F — Format (출력 형식)
원하는 결과물의 형식, 길이, 구조를 지정했는가.
- 20점: 형식 + 길이 + 구조 모두 명시 (예: "표로, 3열, 10행 이내")
- 14점: 형식 지정 있음 (예: "표로 작성해줘")
- 8점: 형식이 암시되어 있으나 불명확
- 0점: 형식 지정 없음

### C — Constraint (제약 조건)
지켜야 할 조건, 제한, 예외 사항을 명시했는가.
- 20점: 복수의 구체적 제약 명시 (예: "이동 시간 30분 이내, 예산 1인 5만원")
- 14점: 1가지 명확한 제약 포함
- 8점: 제약이 있으나 모호함
- 0점: 제약 조건 없음

## 피드백 작성 원칙
- 항목별 피드백은 2~3문장으로, 현재 프롬프트의 구체적인 내용을 언급하며 작성한다.
- 부족한 항목은 개선 방향을 예시와 함께 제안한다.
- 칭찬과 개선점을 균형 있게 작성한다.
- summary는 전체 프롬프트의 강점 1가지와 핵심 개선 포인트 1가지를 포함한 2~3문장으로 작성한다.
- 모든 응답은 한국어로 작성한다.`;

async function scoreWithGemini(prompt, apiKey) {
  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent?key=${apiKey}`;

  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      systemInstruction: { parts: [{ text: SYSTEM_INSTRUCTION }] },
      contents: [{ role: 'user', parts: [{ text: `다음 프롬프트를 평가해주세요:\n\n${prompt}` }] }],
      generationConfig: {
        temperature: 0.1,
        maxOutputTokens: 1024,
        responseMimeType: 'application/json',
      },
    }),
  });

  if (res.status === 429 || res.status === 503) return null; // 폴백 신호
  if (!res.ok) {
    const err = await res.json().catch(() => ({}));
    throw new Error(err?.error?.message || `API 오류 (${res.status})`);
  }

  const data = await res.json();
  const raw = data.candidates?.[0]?.content?.parts?.[0]?.text ?? '';
  console.log('[Gemini] 원본 응답:', raw);

  // 마크다운 코드 펜스 제거
  const cleaned = raw.replace(/^```(?:json)?\s*/i, '').replace(/\s*```\s*$/, '').trim();

  let parsed = null;
  // 1차: 전체 텍스트 직접 파싱
  try { parsed = JSON.parse(cleaned); } catch (_) {}
  // 2차: {...} 블록 추출 후 파싱
  if (!parsed) {
    const match = cleaned.match(/\{[\s\S]*\}/);
    if (match) { try { parsed = JSON.parse(match[0]); } catch (_) {} }
  }

  if (!parsed) { console.error('[Gemini] 파싱 실패'); return null; }

  // 구조 검증 — 필수 필드가 없으면 폴백
  const keys = ['role', 'context', 'instruction', 'format', 'constraint'];
  const valid =
    parsed.scores && keys.every(k => typeof parsed.scores[k] === 'number') &&
    parsed.feedback && keys.every(k => typeof parsed.feedback[k] === 'string') &&
    typeof parsed.summary === 'string';

  if (!valid) { console.error('[Gemini] 구조 불일치:', parsed); return null; }

  return parsed;
}

// ── 키워드 기반 폴백 ─────────────────────────────────────
function scoreWithKeywords(prompt) {
  const p = prompt;
  const toScore = (matched, max) => Math.min(20, Math.round((matched / max) * 20));

  const roleMatches = [
    /너는|당신은|you are/i,
    /전문가|플래너|코치|강사|선생|컨설턴트|분석가|작가|디자이너|개발자|의사|변호사|상담사|매니저|크리에이터/,
  ].filter(r => r.test(p)).length;

  const contextMatches = [
    /\d+명|\d+박\s*\d+일|\d+일|\d+시간|\d+주|\d+달|\d+개월/,
    /나는|제가|우리|저는|친구|부모님|팀원|회사|학교|직장/,
    /현재|지금|요즘|최근|이번|다음|올해|작년/,
    p.length > 80,
  ].filter(r => typeof r === 'boolean' ? r : r.test(p)).length;

  const instrMatches = [
    /써줘|써주세요|작성해/i,
    /만들어|만들어줘/i,
    /알려줘|추천해|분석해|설명해|짜줘|정리해|요약해|비교해/i,
  ].filter(r => r.test(p)).length;

  const formatMatches = [
    /표로|테이블로|목록으로|리스트로/,
    /번호|단계별|순서대로/,
    /\d+자 이내|\d+자 내외|\d+문단|\d+줄|\d+개/,
    /형식|형태|구조|포맷/,
  ].filter(r => r.test(p)).length;

  const constraintMatches = [
    /이내|이하|이상|초과|미만/,
    /금지|빼고|제외|빼줘/,
    /반드시|꼭|무조건/,
    /고려해|주의해|않게|않도록|넘지 않/,
  ].filter(r => r.test(p)).length;

  const scores = {
    role:        toScore(roleMatches, 2),
    context:     toScore(contextMatches, 3),
    instruction: toScore(instrMatches, 2),
    format:      toScore(formatMatches, 2),
    constraint:  toScore(constraintMatches, 2),
  };

  const fb = (s, good, mid, bad) => s >= 16 ? good : s >= 8 ? mid : bad;
  const feedback = {
    role:        fb(scores.role, '역할이 명확하게 지정되어 있습니다.', '역할이 일부 언급됐지만 더 구체적으로 지정해보세요.', '"너는 ~야" 형태로 AI의 역할을 설정해보세요.'),
    context:     fb(scores.context, '충분한 맥락과 배경 정보가 포함되어 있습니다.', '맥락이 일부 있지만 상황을 더 구체적으로 설명해보세요.', '누가, 어떤 상황에서, 왜 필요한지 추가해보세요.'),
    instruction: fb(scores.instruction, '원하는 작업이 명확하게 전달되었습니다.', '지시가 있지만 더 구체적으로 무엇을 해야 하는지 명시해보세요.', '"~해줘", "~작성해줘" 등으로 명확히 요청하세요.'),
    format:      fb(scores.format, '출력 형식이 잘 지정되어 있습니다.', '형식이 일부 언급되어 있습니다. 더 구체적으로 지정해보세요.', '"표로", "번호로", "~자 이내" 등 원하는 형식을 지정해보세요.'),
    constraint:  fb(scores.constraint, '제약 조건이 잘 설정되어 있습니다.', '제약이 일부 있습니다. 더 추가하면 좋겠습니다.', '"~이내", "~빼고", "~고려해줘" 등 제약 조건을 추가해보세요.'),
  };

  const missing = Object.entries(scores).filter(([, s]) => s < 10).map(([k]) => ({ role: '역할(R)', context: '맥락(C)', instruction: '지시(I)', format: '형식(F)', constraint: '제약(C)' }[k]));
  const summary = missing.length === 0
    ? '훌륭합니다! R.C.I.F.C 5가지 요소를 모두 활용한 완성도 높은 프롬프트입니다.'
    : `${missing.join(', ')} 요소가 부족합니다. 해당 항목을 보강하면 더 좋은 답변을 얻을 수 있어요.`;

  return { scores, feedback, summary };
}

// ── UI 유틸 ──────────────────────────────────────────────
function barColor(score) {
  if (score >= 16) return 'bg-neutral-800';
  if (score >= 8)  return 'bg-neutral-400';
  return 'bg-neutral-200';
}

function scoreLabel(total) {
  if (total >= 90) return { label: '완성도 높은 프롬프트', desc: '5가지 요소를 모두 잘 활용했습니다.' };
  if (total >= 70) return { label: '좋은 프롬프트', desc: '대부분의 요소가 포함되어 있습니다.' };
  if (total >= 50) return { label: '보통 프롬프트', desc: '일부 요소를 더 보강하면 좋겠습니다.' };
  if (total >= 30) return { label: '개선이 필요합니다', desc: 'R.C.I.F.C 요소를 추가로 활용해보세요.' };
  return { label: '기초 프롬프트', desc: '역할, 맥락, 형식 등을 추가해보세요.' };
}

function renderResult({ scores, feedback, summary }) {
  const total = Object.values(scores).reduce((a, b) => a + b, 0);
  document.getElementById('total-score').textContent = total;

  const { label, desc } = scoreLabel(total);
  document.getElementById('score-label').textContent = label;
  document.getElementById('score-desc').textContent  = desc;

  ['role', 'context', 'instruction', 'format', 'constraint'].forEach(key => {
    const s = scores[key];
    document.getElementById(`score-${key}`).textContent = `${s} / 20`;
    const bar = document.getElementById(`bar-${key}`);
    bar.style.width = `${(s / 20) * 100}%`;
    bar.className = `h-full rounded-full transition-all duration-500 ${barColor(s)}`;
    document.getElementById(`feedback-${key}`).textContent = feedback[key];
  });

  document.getElementById('summary-text').textContent = summary;
  document.getElementById('result').classList.remove('hidden');
  document.getElementById('result').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── 메인 로직 ────────────────────────────────────────────
const GEMINI_KEY = document.getElementById('app-config')?.dataset.geminiKey ?? '';

const input    = document.getElementById('prompt-input');
const charCount = document.getElementById('char-count');
const btn      = document.getElementById('evaluate-btn');
const btnText  = document.getElementById('btn-text');
const spinner  = document.getElementById('btn-spinner');
const errorBox = document.getElementById('error-box');
const resetBtn = document.getElementById('reset-btn');

input.addEventListener('input', () => {
  charCount.textContent = `${input.value.length}자`;
});

async function evaluate() {
  const prompt = input.value.trim();
  if (!prompt) { input.focus(); return; }

  btn.disabled = true;
  btnText.textContent = '평가 중...';
  spinner.classList.remove('hidden');
  errorBox.classList.add('hidden');
  errorBox.className = 'hidden mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600';
  document.getElementById('result').classList.add('hidden');

  try {
    let result;
    let usedFallback = false;
    if (GEMINI_KEY) {
      result = await scoreWithGemini(prompt, GEMINI_KEY);
      if (!result) {
        usedFallback = true;
        result = scoreWithKeywords(prompt);
      }
    } else {
      await new Promise(r => setTimeout(r, 600));
      result = scoreWithKeywords(prompt);
    }
    renderResult(result);
    if (usedFallback) {
      errorBox.className = 'mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700';
      errorBox.textContent = '요청이 일시적으로 제한되어 키워드 기반 평가로 대체했습니다.';
    }
  } catch (err) {
    errorBox.textContent = err.message || '평가 중 오류가 발생했습니다. 다시 시도해주세요.';
    errorBox.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    btnText.textContent = '평가하기';
    spinner.classList.add('hidden');
  }
}

btn.addEventListener('click', evaluate);
input.addEventListener('keydown', e => { if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') evaluate(); });
resetBtn.addEventListener('click', () => {
  input.value = '';
  charCount.textContent = '0자';
  document.getElementById('result').classList.add('hidden');
  errorBox.classList.add('hidden');
  input.focus();
});
</script>
