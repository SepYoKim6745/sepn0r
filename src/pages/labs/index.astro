---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const baseURL = import.meta.env.BASE_URL;
const allLabs = await getCollection('labs');

const categoryNames = [...new Set(allLabs.map(lab => lab.data.category))].sort();
const grouped = categoryNames.map(cat => ({
  name: cat,
  labs: allLabs
    .filter(lab => lab.data.category === cat)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)),
}));
---

<BaseLayout title="실습 자료 — sepn0r" description="강의 실습 자료 모음">
  <h1 class="text-3xl font-bold tracking-tight">실습 자료</h1>
  <p class="mt-2 text-neutral-500">강의에서 사용하는 실습 자료를 모아둔 곳입니다.</p>

  <div class="mt-8 space-y-10">
    {grouped.map(group => (
      <section>
        <h2 class="text-lg font-semibold text-neutral-800 mb-4 pb-2 border-b border-neutral-200">
          {group.name}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {group.labs.map(lab => (
            <ContentCard
              title={lab.data.title}
              description={lab.data.description}
              tags={lab.data.tags}
              href={`${baseURL}/labs/${lab.id}/`}
            />
          ))}
        </div>
      </section>
    ))}

    <!-- 도구 섹션 (콘텐츠 컬렉션 외 독립 페이지) -->
    <section>
      <h2 class="text-lg font-semibold text-neutral-800 mb-4 pb-2 border-b border-neutral-200">
        도구
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <ContentCard
          title="프롬프트 점수 측정기"
          description="작성한 프롬프트를 R.C.I.F.C 기준으로 평가하고 점수를 확인해보세요."
          tags={["AI", "프롬프트 엔지니어링"]}
          href={`${baseURL}/labs/prompt-scorer/`}
        />
      </div>
    </section>
  </div>
</BaseLayout>
