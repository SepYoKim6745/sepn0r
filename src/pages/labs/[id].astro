---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const baseURL = import.meta.env.BASE_URL;

const allLabs = await getCollection('labs');

const formattedDate = entry.data.pubDate.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<DocsLayout
  title={`${entry.data.title} — sepn0r`}
  description={entry.data.description}
  allLabs={allLabs}
  currentId={entry.id}
>
  <article>
    <header class="mb-10">
      <div class="flex items-center gap-3 text-sm text-neutral-400 mb-4">
        <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
        {entry.data.tags.length > 0 && (
          <span class="text-neutral-200">|</span>
        )}
        {entry.data.tags.length > 0 && (
          <div class="flex gap-1.5">
            {entry.data.tags.map((tag) => (
              <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-500">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight">{entry.data.title}</h1>
      <p class="mt-3 text-lg text-neutral-500 leading-relaxed">{entry.data.description}</p>
    </header>

    {(entry.data.playgroundUrl || entry.data.downloadFile || entry.data.downloads) && (
      <div class="mb-10 flex flex-wrap gap-3">
        {entry.data.playgroundUrl && (
          <a
            href={entry.data.playgroundUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-all duration-200 hover:bg-neutral-700 hover:shadow-lg hover:shadow-neutral-300/30"
          >
            체험하기 &nearr;
          </a>
        )}
        {entry.data.downloadFile && (
          <a
            href={`${baseURL}/downloads/${entry.data.downloadFile}`}
            download
            class="inline-flex items-center gap-2 rounded-full bg-neutral-100 border border-neutral-300 px-5 py-2.5 text-sm font-semibold text-neutral-700 transition-all duration-200 hover:bg-neutral-200 hover:border-neutral-400 hover:text-neutral-900 hover:shadow-md"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            {entry.data.downloadLabel || '다운로드'}
          </a>
        )}
        {entry.data.downloads?.map((dl) => (
          <a
            href={`${baseURL}/downloads/${dl.file}`}
            download
            class="inline-flex items-center gap-2 rounded-full bg-neutral-100 border border-neutral-300 px-5 py-2.5 text-sm font-semibold text-neutral-700 transition-all duration-200 hover:bg-neutral-200 hover:border-neutral-400 hover:text-neutral-900 hover:shadow-md"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            {dl.label}
          </a>
        ))}
      </div>
    )}

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </article>
</DocsLayout>
