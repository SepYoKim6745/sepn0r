---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const portfolio = await getCollection('portfolio');
  return portfolio.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const baseURL = import.meta.env.BASE_URL;
---

<BaseLayout title={`${entry.data.title} — sepn0r`} description={entry.data.description}>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">{entry.data.title}</h1>
      <p class="mt-2 text-neutral-500">{entry.data.description}</p>
      {entry.data.tags.length > 0 && (
        <div class="mt-3 flex gap-1.5">
          {entry.data.tags.map((tag) => (
            <span class="rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-600">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>

    {(entry.data.liveUrl || entry.data.repoUrl) && (
      <div class="mt-8 flex gap-3">
        {entry.data.liveUrl && (
          <a href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700 transition-colors">
            Live Demo &nearr;
          </a>
        )}
        {entry.data.repoUrl && (
          <a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-50 transition-colors">
            GitHub &nearr;
          </a>
        )}
      </div>
    )}
  </article>

  <div class="mt-12 pt-8 border-t border-neutral-200">
    <a href={`${baseURL}/portfolio/`} class="text-sm text-neutral-500 hover:text-neutral-900 transition-colors">
      &larr; 모든 포트폴리오
    </a>
  </div>
</BaseLayout>
