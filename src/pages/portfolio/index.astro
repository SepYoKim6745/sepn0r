---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import { getCollection } from 'astro:content';

const baseURL = import.meta.env.BASE_URL;
const allPortfolio = await getCollection('portfolio');
const sortedPortfolio = allPortfolio.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="포트폴리오 — sepn0r" description="프로젝트 포트폴리오">
  <section class="fade-in">
    <p class="text-sm font-medium text-neutral-400 tracking-widest uppercase">Portfolio</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">포트폴리오</h1>
    <p class="mt-4 text-lg text-neutral-500 max-w-2xl leading-relaxed">
      진행한 프로젝트들을 모아둔 곳입니다.
    </p>
  </section>

  {sortedPortfolio.length > 0 ? (
    <div class="mt-14 grid gap-4 sm:grid-cols-2 fade-in fade-in-delay-2">
      {sortedPortfolio.map((item) => (
        <ContentCard
          title={item.data.title}
          description={item.data.description}
          tags={item.data.tags}
          href={`${baseURL}/portfolio/${item.id}/`}
        />
      ))}
    </div>
  ) : (
    <div class="mt-24 text-center fade-in fade-in-delay-2">
      <p class="text-lg text-neutral-300 font-medium">곧 공개됩니다.</p>
      <p class="mt-2 text-sm text-neutral-300">프로젝트를 준비하고 있습니다.</p>
    </div>
  )}
</BaseLayout>
