---
import BaseLayout from '../layouts/BaseLayout.astro';
const baseURL = import.meta.env.BASE_URL;
---

<BaseLayout title="404 — 페이지를 찾을 수 없습니다">
  <div class="py-24 sm:py-32 text-center fade-in">
    <p class="text-8xl sm:text-9xl font-bold text-neutral-100 select-none">404</p>
    <p class="mt-6 text-lg text-neutral-500">페이지를 찾을 수 없습니다.</p>
    <a
      href={baseURL}
      class="mt-10 inline-flex items-center rounded-full bg-neutral-900 px-6 py-3 text-sm font-medium text-white transition-all duration-200 hover:bg-neutral-700 hover:shadow-lg hover:shadow-neutral-300/30"
    >
      홈으로 돌아가기
    </a>
  </div>
</BaseLayout>
