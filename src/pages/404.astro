---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — 페이지를 찾을 수 없습니다">
  <div class="py-24 text-center">
    <h1 class="text-6xl font-bold text-neutral-200">404</h1>
    <p class="mt-4 text-lg text-neutral-500">페이지를 찾을 수 없습니다.</p>
    <a href="/" class="mt-8 inline-flex items-center rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-neutral-700 transition-colors">
      홈으로 돌아가기
    </a>
  </div>
</BaseLayout>
